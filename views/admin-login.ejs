<%- include('partials/header') %>

<section class="form-page form-page--narrow">
  <div class="sheet sheet--flagged">
    <div class="sheet__pad">
      <header class="form-intro">
        <p class="eyebrow">Protected area</p>
        <h1 class="display-lg">Admin sign in.</h1>
        <p class="lede">Moderate stories and choose the Gem of the Week.</p>
      </header>

      <% if (typeof error !== 'undefined') { %>
        <div class="notice notice--error gap-top-lg" role="alert"><%= error %></div>
      <% } %>

      <form action="/admin/login" method="POST" class="form">
        <div class="field">
          <label for="password" class="field__label">Admin password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required class="input">
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Sign in <span class="arrow" aria-hidden="true">&rarr;</span></button>
          <a href="/posts" class="btn btn--ghost">Back to site</a>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<% if (isHomePage) { %>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow">Travel stories from Malawi</p>
      <h1 id="hero-title" class="display-xl hero__title">Malawi's <em>hidden</em> places, shared by the people who found them.</h1>
      <p class="lede">Quiet beaches on the lake, misty plateaus, roadside food worth the detour. Read honest stories from fellow travellers, find them on the map, and add your own. No account needed.</p>
      <div class="btn-row">
        <a href="/posts/new" class="btn btn--primary">Share your experience <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/posts" class="btn btn--ghost">Browse every gem</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__photo">
        <img src="/images/hero-bg.jpg" alt="" fetchpriority="high">
      </div>
      <div class="hero__stamp">
        <div>
          <span class="hero__stamp-number"><%= pagination.totalPosts %></span>
          <span class="hero__stamp-label">gems shared so far</span>
        </div>
      </div>
    </div>
  </section>
<% } else { %>
  <header class="page-intro">
    <p class="eyebrow">Explore</p>
    <h1 class="display-lg"><%= searchQuery ? 'Search results' : (activeTag ? activeTag.name + ' stories' : 'Every hidden gem') %></h1>
    <p class="lede">Search by place or keyword, filter by theme, and open the map to see where each story lives.</p>
  </header>
<% } %>

<% if (isHomePage && featuredPost) { %>
  <section class="feature" aria-labelledby="feature-title">
    <div class="feature__media">
      <img src="<%= featuredPost.imageUrl %>" alt="<%= featuredPost.title %>" loading="lazy">
      <span class="feature__ribbon">Gem of the week</span>
    </div>
    <div class="feature__body">
      <ul class="meta">
        <li><%= featuredPost.authorName %></li>
        <% if (featuredPost.location) { %><li><%= featuredPost.location %></li><% } %>
        <li><%= featuredPost.readTime %></li>
      </ul>
      <h2 id="feature-title" class="display-lg"><%= featuredPost.title %></h2>
      <% if (featuredPost.tags.length) { %>
        <ul class="tag-list">
          <% featuredPost.tags.forEach((tag) => { %>
            <li><a href="<%= buildTagUrl(tag.slug) %>" class="tag"><%= tag.name %></a></li>
          <% }) %>
        </ul>
      <% } %>
      <p><%= featuredPost.excerpt %></p>
      <a href="/posts/<%= featuredPost.id %>" class="btn btn--sun">Read the feature <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
<% } %>

<section class="finder" aria-label="Search and map">
  <div class="sheet sheet--flagged">
    <div class="sheet__pad finder__panel">
      <div>
        <p class="eyebrow">Search and filter</p>
        <h2 class="display-md gap-top-sm">Find your next Malawi experience.</h2>
      </div>
      <form action="/posts/search" method="GET" class="search-form" role="search">
        <label for="searchQuery" class="sr-only">Search stories</label>
        <input type="search" id="searchQuery" name="q" value="<%= searchQuery %>" placeholder="Places, stories, food, wildlife..." class="input">
        <% if (activeTag) { %>
          <input type="hidden" name="tag" value="<%= activeTag.slug %>">
        <% } %>
        <button type="submit" class="btn btn--primary">Search</button>
      </form>
      <ul class="tag-list" aria-label="Filter by theme">
        <li><a href="<%= searchQuery ? '/posts/search?q=' + encodeURIComponent(searchQuery) : '/posts' %>" class="tag tag--lg<%= !activeTag ? ' is-active' : '' %>">All</a></li>
        <% tags.forEach((tag) => { %>
          <li><a href="<%= buildTagUrl(tag.slug) %>" class="tag tag--lg<%= activeTag && activeTag.slug === tag.slug ? ' is-active' : '' %>"<%- activeTag && activeTag.slug === tag.slug ? ' aria-current="true"' : '' %>><%= tag.name %></a></li>
        <% }) %>
      </ul>
      <div class="filter-summary">
        <span><%= totalMatchesLabel %></span>
        <% if (searchQuery || activeTag) { %>
          <a href="<%= clearFiltersUrl %>" class="btn btn--ghost btn--sm">Clear filters</a>
        <% } %>
      </div>
    </div>
  </div>

  <div data-map-shell class="sheet map-card">
    <div class="sheet__head">
      <p class="eyebrow">Destination map</p>
      <h2 class="display-md gap-top-sm">Stories plotted across Malawi.</h2>
    </div>
    <div class="map-card__canvas map-card__canvas--tall" data-map-mode="collection" data-source="<%= mapEndpoint %>" role="region" aria-label="Map of destinations"></div>
  </div>
</section>

<section aria-labelledby="stories-title">
  <div class="section-head">
    <div>
      <p class="eyebrow"><%= isHomePage ? 'Fresh arrivals' : 'Results' %></p>
      <h2 id="stories-title" class="display-lg"><%= isHomePage ? 'Latest hidden gems' : 'Matching destinations' %></h2>
    </div>
    <p class="section-head__aside">Page <%= pagination.currentPage %> of <%= pagination.totalPages %></p>
  </div>

  <% if (!posts.length) { %>
    <div class="empty-state gap-top-lg">
      <p class="eyebrow">Nothing here yet</p>
      <h3 class="display-md gap-top-md">No gems found.</h3>
      <p class="lede gap-top-md"><%= noResultsMessage %></p>
      <div class="btn-row btn-row--center gap-top-lg">
        <a href="/posts/new" class="btn btn--primary">Share a destination</a>
      </div>
    </div>
  <% } else { %>
    <ol class="story-grid">
      <% posts.forEach((post) => { %>
        <li>
          <article class="story-card">
            <div class="story-card__media">
              <img src="<%= post.imageUrl %>" alt="" loading="lazy">
              <span class="story-card__time"><%= post.readTime %></span>
            </div>
            <div class="story-card__body">
              <% if (post.location) { %>
                <ul class="meta"><li><%= post.location %></li></ul>
              <% } %>
              <h3 class="story-card__title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
              <p class="story-card__excerpt"><%= post.excerpt %></p>
              <% if (post.tags.length) { %>
                <ul class="tag-list">
                  <% post.tags.forEach((tag) => { %>
                    <li><a href="<%= buildTagUrl(tag.slug) %>" class="tag"><%= tag.name %></a></li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
            <div class="story-card__foot">
              <span class="story-card__author">by <strong><%= post.authorName %></strong></span>
              <% if (post.canEdit) { %>
                <div class="editor-controls" data-post-id="<%= post.id %>">
                  <a href="/posts/<%= post.id %>/edit" class="btn btn--ghost btn--sm">Edit</a>
                  <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="delete-form">
                    <button type="submit" class="btn btn--danger btn--sm">Delete</button>
                  </form>
                </div>
              <% } %>
            </div>
          </article>
        </li>
      <% }) %>
    </ol>
  <% } %>

  <% if (pagination.totalPages > 1) { %>
    <nav class="pagination" aria-label="Pagination">
      <% if (pagination.hasPreviousPage) { %>
        <a href="<%= pagination.previousPageUrl %>" class="btn btn--ghost" rel="prev"><span aria-hidden="true">&larr;</span> Previous</a>
      <% } else { %>
        <span class="btn btn--ghost is-disabled" aria-disabled="true"><span aria-hidden="true">&larr;</span> Previous</span>
      <% } %>
      <span class="pagination__status">Page <%= pagination.currentPage %> of <%= pagination.totalPages %></span>
      <% if (pagination.hasNextPage) { %>
        <a href="<%= pagination.nextPageUrl %>" class="btn btn--primary" rel="next">Next <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <% } else { %>
        <span class="btn btn--primary is-disabled" aria-disabled="true">Next <span aria-hidden="true">&rarr;</span></span>
      <% } %>
    </nav>
  <% } %>
</section>

<%- include('partials/footer') %>

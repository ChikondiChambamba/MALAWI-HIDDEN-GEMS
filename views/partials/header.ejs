<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const pageTitle = (seo && seo.title) || title || siteName; %>
  <% const pageSummary = (seo && seo.description) || pageDescription || siteName; %>
  <% const pageImage = (seo && seo.imageUrl) || (siteUrl + '/images/logo.png'); %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageSummary %>">
  <meta name="theme-color" content="#15120e">
  <meta property="og:site_name" content="<%= (seo && seo.siteName) || siteName %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageSummary %>">
  <meta property="og:type" content="<%= (seo && seo.type) || 'website' %>">
  <meta property="og:url" content="<%= (seo && seo.canonicalUrl) || currentUrl %>">
  <meta property="og:image" content="<%= pageImage %>">
  <meta property="og:image:alt" content="<%= (seo && seo.imageAlt) || siteName %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageSummary %>">
  <meta name="twitter:image" content="<%= pageImage %>">
  <link rel="canonical" href="<%= (seo && seo.canonicalUrl) || currentUrl %>">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/images/logo.png">
  <link rel="apple-touch-icon" href="/images/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <% if (needsLeaflet) { %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <% } %>
  <link rel="stylesheet" href="/css/style.css">
  <% if (seo && seo.noIndex) { %>
    <meta name="robots" content="noindex,nofollow">
  <% } %>
  <% if (Array.isArray(structuredData)) { %>
    <% structuredData.forEach((item) => { %>
      <script type="application/ld+json"><%- JSON.stringify(item).replace(/</g, '\u003c') %></script>
    <% }) %>
  <% } %>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <header class="site-header">
    <div class="container">
      <div class="site-header__bar">
        <a href="/" class="brand" aria-label="<%= siteName %> home">
          <span class="brand__mark">
            <img src="/images/logo.png" alt="" width="52" height="52">
          </span>
          <span>
            <span class="brand__name"><%= siteName %></span>
            <span class="brand__tag">Stories from the warm heart of Africa</span>
          </span>
        </a>
        <form action="/posts/search" method="GET" class="header-search" role="search">
          <label for="headerSearch" class="sr-only">Search stories</label>
          <input type="search" id="headerSearch" name="q" value="<%= navSearchQuery %>" placeholder="Search lakes, peaks, food...">
          <button type="submit">Search</button>
        </form>
      </div>
    </div>
    <%- include('navigation') %>
  </header>

  <main id="main-content" class="site-main container">

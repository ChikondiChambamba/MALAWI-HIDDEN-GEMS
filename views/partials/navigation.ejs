<%
  const navLinks = [
    { href: '/', label: 'Home', active: currentPath === '/' },
    { href: '/posts', label: 'Explore', active: currentPath === '/posts' || currentPath === '/posts/search' },
    { href: '/about', label: 'About', active: currentPath === '/about' },
    { href: '/contact', label: 'Contact', active: currentPath === '/contact' },
  ];
  const shareActive = currentPath === '/posts/new' || currentPath === '/create';
  const adminActive = currentPath.startsWith('/admin');
%>
<nav class="site-nav" aria-label="Main">
  <div class="container">
    <ul class="site-nav__list">
      <% navLinks.forEach((link) => { %>
        <li>
          <a href="<%= link.href %>" class="site-nav__link<%= link.active ? ' is-active' : '' %>"<%- link.active ? ' aria-current="page"' : '' %>><%= link.label %></a>
        </li>
      <% }) %>
      <li class="site-nav__item--push">
        <a href="/posts/new" class="site-nav__link site-nav__cta<%= shareActive ? ' is-active' : '' %>"<%- shareActive ? ' aria-current="page"' : '' %>>Share a gem</a>
      </li>
      <li>
        <a href="<%= isAdmin ? '/admin/dashboard' : '/admin/login' %>" class="site-nav__link site-nav__admin<%= adminActive ? ' is-active' : '' %>"><%= isAdmin ? 'Dashboard' : 'Admin' %></a>
      </li>
    </ul>
  </div>
</nav>

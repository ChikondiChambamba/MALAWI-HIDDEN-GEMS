<%- include('partials/header') %>
<% const hasMapCoordinates = typeof post.latitude === 'number' && typeof post.longitude === 'number'; %>
<% const hasCustomImage = post.imagePath && post.imagePath !== 'default.jpg'; %>

<div class="story-layout">
  <article class="sheet story">
    <% if (editorAccessGranted) { %>
      <div class="notice notice--success">
        <strong>Your story is live. Editing access is saved in this browser.</strong>
        Come back from this device any time to edit or delete it. Clearing your cookies removes that access.
      </div>
    <% } %>

    <% if (hasCustomImage) { %>
      <figure class="story__hero">
        <img src="<%= post.imageUrl %>" alt="<%= post.title %>" fetchpriority="high">
      </figure>
    <% } %>

    <header class="story__header">
      <p class="eyebrow">Destination story</p>
      <h1 class="display-xl"><%= post.title %></h1>
      <ul class="meta">
        <li><%= post.authorName %></li>
        <% if (post.location) { %><li><%= post.location %></li><% } %>
        <li><%= post.readTime %></li>
      </ul>
      <% if (post.tags.length) { %>
        <ul class="tag-list">
          <% post.tags.forEach((tag) => { %>
            <li><a href="/posts?tag=<%= encodeURIComponent(tag.slug) %>" class="tag tag--lg"><%= tag.name %></a></li>
          <% }) %>
        </ul>
      <% } %>
    </header>

    <div class="prose">
      <%- post.formattedContent %>
    </div>
  </article>

  <aside class="story-aside">
    <section class="sheet sheet--flagged">
      <div class="sheet__pad">
        <p class="eyebrow">About this story</p>
        <dl class="facts">
          <div>
            <dt>Published</dt>
            <dd><time datetime="<%= new Date(post.createdAt).toISOString() %>"><%= new Date(post.createdAt).toDateString() %></time></dd>
          </div>
          <div>
            <dt>Updated</dt>
            <dd><time datetime="<%= new Date(post.updatedAt).toISOString() %>"><%= new Date(post.updatedAt).toDateString() %></time></dd>
          </div>
          <div>
            <dt>Contributor</dt>
            <dd><%= post.authorName %></dd>
          </div>
          <% if (post.location) { %>
            <div>
              <dt>Location</dt>
              <dd><%= post.location %></dd>
            </div>
          <% } %>
          <div>
            <dt>Reading time</dt>
            <dd><%= post.readTime %></dd>
          </div>
        </dl>
      </div>
    </section>

    <% if (hasMapCoordinates) { %>
      <section data-map-shell class="sheet map-card" aria-labelledby="map-title">
        <div class="sheet__head">
          <p class="eyebrow">Map and directions</p>
          <h2 id="map-title" class="display-md gap-top-sm">Find your way to this gem.</h2>
        </div>
        <div
          class="map-card__canvas"
          data-map-mode="single"
          data-latitude="<%= post.latitude %>"
          data-longitude="<%= post.longitude %>"
          data-title="<%= post.title %>"
          data-location="<%= post.location || 'Malawi' %>"
          role="region"
          aria-label="Map showing <%= post.title %>"
        ></div>
        <div class="map-directions" data-directions data-latitude="<%= post.latitude %>" data-longitude="<%= post.longitude %>">
          <a
            class="btn btn--ghost"
            href="https://www.openstreetmap.org/?mlat=<%= post.latitude %>&mlon=<%= post.longitude %>#map=13/<%= post.latitude %>/<%= post.longitude %>"
            target="_blank"
            rel="noopener noreferrer"
          >Open in OpenStreetMap</a>
          <button type="button" class="btn btn--primary" data-directions-button>Directions from my location</button>
          <p class="map-directions__status" data-directions-status aria-live="polite"></p>
        </div>
      </section>
    <% } %>

    <section class="sheet">
      <div class="sheet__pad btn-row">
        <a href="/posts" class="btn btn--ghost btn--block"><span aria-hidden="true">&larr;</span> All experiences</a>
        <% if (post.canEdit) { %>
          <a href="/posts/<%= post.id %>/edit" class="btn btn--primary btn--block">Edit this story</a>
          <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="delete-form">
            <button type="submit" class="btn btn--danger btn--block">Delete story</button>
          </form>
        <% } %>
      </div>
    </section>
  </aside>
</div>

<%- include('partials/footer') %>

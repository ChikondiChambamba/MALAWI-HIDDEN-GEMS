<%- include('partials/header') %>

<div class="contact-layout">
  <aside class="contact-card">
    <p class="eyebrow eyebrow--light">Contact</p>
    <h1 class="display-lg">Let's talk about tourism, partnerships and ideas.</h1>
    <p class="lede">Send the team editorial suggestions, destination partnerships or feedback on the site.</p>
    <dl class="contact-list">
      <div>
        <dt>Email</dt>
        <dd><a href="mailto:info@malawitourism.com">info@malawitourism.com</a></dd>
      </div>
      <div>
        <dt>Phone</dt>
        <dd><a href="tel:+265885040112">+265 885 040 112</a></dd>
      </div>
      <div>
        <dt>Office</dt>
        <dd>Tourism House, Lilongwe, Malawi</dd>
      </div>
    </dl>
  </aside>

  <section class="sheet sheet--flagged" aria-labelledby="contact-form-title">
    <div class="sheet__pad">
      <p class="eyebrow">Send a message</p>
      <h2 id="contact-form-title" class="display-md gap-top-sm">We usually reply within two working days.</h2>

      <% if (typeof error !== 'undefined') { %>
        <div class="notice notice--error gap-top-lg" role="alert"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined') { %>
        <div class="notice notice--success gap-top-lg" role="status"><%= success %></div>
      <% } %>

      <form action="/contact" method="POST" class="form">
        <div class="form-grid">
          <div class="field">
            <label for="name" class="field__label">Your name</label>
            <input type="text" id="name" name="name" value="<%= form.name %>" maxlength="120" autocomplete="name" required class="input">
          </div>
          <div class="field">
            <label for="email" class="field__label">Email address</label>
            <input type="email" id="email" name="email" value="<%= form.email %>" maxlength="255" autocomplete="email" required class="input">
          </div>
          <div class="field field--full">
            <label for="message" class="field__label">Message</label>
            <textarea id="message" name="message" rows="6" maxlength="4000" required class="input"><%= form.message %></textarea>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Send message <span class="arrow" aria-hidden="true">&rarr;</span></button>
          <a href="/posts" class="btn btn--ghost">Back to stories</a>
        </div>
      </form>
    </div>
  </section>
</div>

<%- include('partials/footer') %>

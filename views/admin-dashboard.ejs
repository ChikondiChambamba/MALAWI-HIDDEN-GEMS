<%- include('partials/header') %>

<div class="admin-head">
  <div class="admin-head__text">
    <p class="eyebrow">Dashboard</p>
    <h1 class="display-lg">Curate the next standout story.</h1>
    <p class="lede">Feature a story on the homepage for seven days, or remove stories that break the guidelines.</p>
  </div>
  <div class="btn-row">
    <a href="/posts" class="btn btn--ghost">Back to site</a>
    <form action="/admin/logout" method="POST">
      <button type="submit" class="btn btn--danger">Log out</button>
    </form>
  </div>
</div>

<% if (!posts.length) { %>
  <div class="empty-state gap-top-lg">
    <p class="eyebrow">Empty</p>
    <h2 class="display-md gap-top-md">No stories yet.</h2>
    <p class="lede gap-top-md">New stories will appear here as soon as contributors publish them.</p>
  </div>
<% } else { %>
  <ul class="admin-list">
    <% posts.forEach((post) => { %>
      <li>
        <article class="sheet admin-row<%= post.isCurrentlyFeatured ? ' is-featured' : '' %>">
          <div class="admin-row__media">
            <img src="<%= post.imageUrl %>" alt="" loading="lazy">
          </div>
          <div class="admin-row__body">
            <ul class="meta">
              <li><%= post.authorName %></li>
              <% if (post.location) { %><li><%= post.location %></li><% } %>
              <li><%= post.readTime %></li>
              <li><time datetime="<%= new Date(post.createdAt).toISOString() %>"><%= new Date(post.createdAt).toDateString() %></time></li>
            </ul>
            <h2 class="admin-row__title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
            <% if (post.isCurrentlyFeatured) { %>
              <div><span class="badge">&#9733; Featured until <%= new Date(post.featuredUntil).toDateString() %></span></div>
            <% } %>
            <p class="muted"><%= post.excerpt %></p>
            <% if (post.tags.length) { %>
              <ul class="tag-list">
                <% post.tags.forEach((tag) => { %>
                  <li><span class="tag"><%= tag.name %></span></li>
                <% }) %>
              </ul>
            <% } %>
            <div class="btn-row">
              <a href="/posts/<%= post.id %>" class="btn btn--ghost btn--sm">View</a>
              <form action="/admin/posts/<%= post.id %>/feature" method="POST">
                <button type="submit" class="btn btn--sun btn--sm"><%= post.isCurrentlyFeatured ? 'Extend feature 7 days' : 'Feature this story' %></button>
              </form>
              <form action="/admin/posts/<%= post.id %>/delete" method="POST" class="delete-form">
                <button type="submit" class="btn btn--danger btn--sm">Delete</button>
              </form>
            </div>
          </div>
        </article>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>

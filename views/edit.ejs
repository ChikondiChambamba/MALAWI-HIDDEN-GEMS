<%- include('partials/header') %>

<section class="form-page">
  <div class="sheet sheet--flagged">
    <div class="sheet__pad">
      <header class="form-intro">
        <p class="eyebrow">Editor mode</p>
        <h1 class="display-lg">Refine your story.</h1>
        <p class="lede">Update the text, map coordinates, tags or photo. Your editing access stays the same.</p>
      </header>

      <% if (typeof error !== 'undefined') { %>
        <div class="notice notice--error gap-top-lg" role="alert"><%= error %></div>
      <% } %>

      <%- include('partials/post-form', {
        action: '/posts/' + post.id + '?_method=PUT',
        submitLabel: 'Save changes',
        cancelHref: '/posts/' + post.id,
        currentImageUrl: post.imagePath && post.imagePath !== 'default.jpg' ? post.imageUrl : null,
      }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

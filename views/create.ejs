<%- include('partials/header') %>

<section class="form-page">
  <div class="sheet sheet--flagged">
    <div class="sheet__pad">
      <header class="form-intro">
        <p class="eyebrow">New contribution</p>
        <h1 class="display-lg">Share a hidden gem.</h1>
        <p class="lede">Tell other travellers about a place you love. Add a photo, a few tags, and optional coordinates so it appears on the map.</p>
      </header>

      <% if (typeof error !== 'undefined') { %>
        <div class="notice notice--error gap-top-lg" role="alert"><%= error %></div>
      <% } %>

      <%- include('partials/post-form', {
        action: '/posts',
        submitLabel: 'Publish story',
        cancelHref: '/posts',
        currentImageUrl: null,
      }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
